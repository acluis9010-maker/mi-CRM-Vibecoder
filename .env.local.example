# ─── Convex ──────────────────────────────────────────────────────────────────
# Generadas automáticamente por `npx convex dev` la primera vez que lo corras
# (crea/enlaza el proyecto de Convex y escribe estos valores en .env.local).
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# ─── Clerk (autenticación — LUI-7) ───────────────────────────────────────────
# Se obtienen del dashboard de Clerk tras crear la aplicación.
# IMPORTANTE: en Clerk hay que deshabilitar el registro público y restringirlo
# a invitaciones — los usuarios solo los crea la Dueña (ver LUI-7).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# El login de esta app vive en /login, no en la ruta /sign-in que Clerk asume
# por defecto. Sin declararlo, algunos redirects de Clerk darían 404.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/login

# ─── Variable del deployment de Convex (NO va en .env.local) ─────────────────
# CLERK_JWT_ISSUER_DOMAIN se configura en Convex, no aquí:
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://<tu-app>.clerk.accounts.dev
# Y en producción, además:
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://... --prod
#
# ─── Railway (producción) ────────────────────────────────────────────────────
# Variables a configurar en Railway:
#   CONVEX_DEPLOY_KEY                  (clave de deploy de producción de Convex)
#   NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
#   CLERK_SECRET_KEY
#   NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
#   NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/login
# NO fijar NEXT_PUBLIC_CONVEX_URL a mano: la inyecta el buildCommand con
# `convex deploy --cmd-url-env-var-name` (ver railway.json).
